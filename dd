function Window:SetBackgroundImage(assetId: string | number?, transparency: number?)
	if self.BackgroundImage then
		self.BackgroundImage:Destroy()
		self.BackgroundImage = nil
	end

	if not assetId or assetId == "" or assetId == 0 then
		return
	end

	local imageStr = typeof(assetId) == "number" and ("rbxassetid://" .. tostring(assetId)) or tostring(assetId)
	if not imageStr:find("rbxassetid://") and not imageStr:find("http") then
		imageStr = "rbxassetid://" .. imageStr
	end

	local img = Add("ImageLabel", {
		Parent = self.Canvas,
		Name = "BackgroundImage",
		Size = UFS(1, 1),
		Position = UFS(0, 0),
		BackgroundTransparency = 1,
		Image = imageStr,
		ImageTransparency = MC(transparency or 0, 0, 1),
		ScaleType = SCL.Stretch, -- fills the entire UI perfectly
		ZIndex = 0, -- behind everything
		BorderSizePixel = 0,
	})
	Corner(img) -- match window corner radius

	self.BackgroundImage = img
end

