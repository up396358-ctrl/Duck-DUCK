local KeybindBlacklist = {
	[EKC.Unknown] = true,
}

local MouseBindNames = {
	[UIT.MouseButton1] = "LMB",
	[UIT.MouseButton2] = "RMB",
	[UIT.MouseButton3] = "MMB",
}

local KeyShortNames = {
	LeftShift = "LSHIFT",
	RightShift = "RSHIFT",
	LeftControl = "LCTRL",
	RightControl = "RCTRL",
	LeftAlt = "LALT",
	RightAlt = "RALT",
	Return = "ENTER",
	Backspace = "BKSP",
	CapsLock = "CAPS",
	Escape = "ESC",
	Insert = "INS",
	Delete = "DEL",
	PageUp = "PGUP",
	PageDown = "PGDN",
	Zero = "0", One = "1", Two = "2", Three = "3", Four = "4",
	Five = "5", Six = "6", Seven = "7", Eight = "8", Nine = "9",
}

local function BindName(bind: EnumItem?): string
	if not bind then
		return "NONE"
	end
	if bind.EnumType == Enum.UserInputType then
		return MouseBindNames[bind] or bind.Name:upper()
	end
	return KeyShortNames[bind.Name] or bind.Name:upper()
end

function Section:AddKeybind(options: { [string]: any })
	local _, _, right = self:_Row(options.Title or "Keybind")
	local current: EnumItem? = options.Default
	local binding = false
	local lastBound = 0

	local box = Add("TextButton", {
		Parent = right,
		LayoutOrder = 2,
		Name = "Box",
		Text = "",
		AutoButtonColor = false,
		Active = true,
		Selectable = false,
		Size = UFO(0, 20),
		AutomaticSize = AT.X,
		BorderSizePixel = 0,
	})
	Corner(box, 0)
	local stroke = Stroke(box, "Border", true)
	Bind(box, { BackgroundColor3 = "Foreground" })
	Add("UISizeConstraint", { Parent = box, MinSize = V2(46, 20) })
	Padding(box, 0, 0, 8, 8)

	local button = Text(box, {
		Name = "Keybind",
		Text = BindName(current),
		TextSize = 12,
		TextTransparency = 0.5,
		TextXAlignment = TXA.Center,
		TextTruncate = ETT.None,
		Size = UFS(0, 1),
		AutomaticSize = AT.X,
	})

	local function save()
		if options.Flag then
			Callisto.Flags[options.Flag] = current
		end
	end

	local function render()
		button.Text = binding and "PRESS A KEY..." or BindName(current)
		Tween(button, Anim.Fast, {
			TextTransparency = binding and 0 or 0.5,
			TextColor3 = binding and Callisto.Theme.Accent or Callisto.Theme.Text,
		})
		Tween(stroke, Anim.Fast, { Color = binding and Callisto.Theme.Accent or Callisto.Theme.Border })
	end

	local function finish(newBind: EnumItem?, changed: boolean)
		if changed then
			current = newBind
		end
		binding = false
		lastBound = os.clock()
		render()
		save()
	end

	Connect(box.MouseButton1Click, function()
		-- ignore the click that just assigned a mouse button
		if binding or os.clock() - lastBound < 0.2 then
			return
		end
		binding = true
		render()
	end)

	Hover(box, function(hovering)
		if not binding then
			Tween(button, Anim.Fast, { TextTransparency = hovering and 0.2 or 0.5 })
			Tween(stroke, Anim.Fast, { Color = hovering and Callisto.Theme.Accent or Callisto.Theme.Border })
		end
	end)

	Connect(UserInputService.InputBegan, function(input, processed)
		if binding then
			if input.UserInputType == UIT.Keyboard and not KeybindBlacklist[input.KeyCode] then
				if input.KeyCode == EKC.Escape then
					finish(current, false) -- cancel, keep the old bind
				elseif input.KeyCode == EKC.Backspace then
					finish(nil, true) -- clear
				else
					finish(input.KeyCode, true)
				end
			elseif MouseBindNames[input.UserInputType] then
				finish(input.UserInputType, true)
			end
			return
		end

		if processed or not current or not options.Callback then
			return
		end
		local match = false
		if current.EnumType == Enum.UserInputType then
			match = input.UserInputType == current
		else
			match = input.UserInputType == UIT.Keyboard and input.KeyCode == current
		end
		if match then
			task.spawn(options.Callback, current)
		end
	end)

	render()

	return {
		Instance = box,
		Get = function()
			return current
		end,
		Set = function(_, key: EnumItem?)
			current = key
			render()
			save()
		end,
	}
end

function Section:AddSlider(options: { [string]: any })
	local minimum = options.Min or 0
	local maximum = options.Max or 100
	local decimals = options.Decimals or 0
	local suffix = options.Suffix or "%"
	local value = MC(options.Default or minimum, minimum, maximum)

	local container = Add("Frame", {
		Parent = self.Content,
		Name = "Slider",
		BackgroundTransparency = 1,
		Size = UFS(1, 0),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
		LayoutOrder = self:_Order(),
	})
	List(container, { Padding = UD(0, 5) })

	local textHolder = Add("Frame", {
		Parent = container,
		Name = "TextHolder",
		BackgroundTransparency = 1,
		Size = UD2(1, 0, 0, 0),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
	})
	List(textHolder, {
		FillDirection = FD.Horizontal,
		VerticalAlignment = VFA.Center,
		Padding = UD(0, 7),
	})

	local title = Text(textHolder, {
		Name = "Title",
		LayoutOrder = 1,
		Text = options.Title or "slider",
		TextWrapped = true,
		TextXAlignment = TXA.Left,
		TextTruncate = ETT.None,
		Size = UD2(0, 0, 0, 0),
		AutomaticSize = AT.Y,
	})
	Add("UIFlexItem", { Parent = title, FlexMode = Enum.UIFlexMode.Fill })

	local current = Text(textHolder, {
		Name = "Current",
		LayoutOrder = 2,
		Text = "0" .. suffix,
		TextXAlignment = TXA.Right,
		TextTruncate = ETT.None,
		AutomaticSize = AT.XY,
	})

	local track = Add("TextButton", {
		Parent = container,
		LayoutOrder = 1,
		Text = "",
		AutoButtonColor = false,
		Name = "Button",
		Size = UD2(1, 0, 0, 16),
		BorderSizePixel = 0,
	})
	Corner(track, 0)
	local trackStroke = Stroke(track, "Border", true)
	Bind(track, { BackgroundColor3 = "Foreground" })

	local fill = Add("Frame", {
		Parent = track,
		Name = "Fill",
		Size = UD2(0, 0, 1, 0),
		BorderSizePixel = 0,
	})
	Corner(fill, 0)
	Bind(fill, { BackgroundColor3 = "Accent" })

	local function round(number: number): number
		local multiplier = 10 ^ decimals
		return MF(number * multiplier + 0.5) / multiplier
	end

	local function render()
		local progress = (value - minimum) / (maximum - minimum)
		fill.Size = UD2(progress, 0, 1, 0)
		current.Text = tostring(round(value)) .. suffix
	end

	local function set(newValue: number, silent: boolean?)
		value = MC(round(newValue), minimum, maximum)
		render()
		if options.Flag then
			Callisto.Flags[options.Flag] = value
		end
		if options.Callback and not silent then
			task.spawn(options.Callback, value)
		end
	end

	local dragging = false
	local function updateFromInput(position: Vector3 | Vector2)
		local progress = MC((position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
		set(minimum + (maximum - minimum) * progress)
	end

	Connect(track.InputBegan, function(input)
		if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
			dragging = true
			updateFromInput(input.Position)
		end
	end)
	Connect(UserInputService.InputEnded, function(input)
		if input.UserInputType == UIT.MouseButton1 or input.UserInputType == UIT.Touch then
			dragging = false
		end
	end)
	Connect(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == UIT.MouseMovement or input.UserInputType == UIT.Touch) then
			updateFromInput(input.Position)
		end
	end)

	Hover(track, function(hovering)
		Tween(trackStroke, Anim.Base, {
			Color = hovering and Callisto.Theme.Accent or Callisto.Theme.Border,
		})
	end)

	set(value, true)

	return {
		Instance = container,
		Get = function()
			return value
		end,
