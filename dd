	if self.BackgroundImage then
		self.BackgroundImage.ImageTransparency = MC(transparency, 0, 1)
	end
end

function Window:Toggle(state: boolean?)
	local open = state
	if open == nil then
		open = not self.Visible
	end
	if open == self.Visible then
		return
	end
	self.Visible = open

	local canvas: any = self.Canvas

	if open then
		local home: UDim2 = self.HomePosition or canvas.Position
		self.HomePosition = home
		self.ScreenGui.Enabled = true
		canvas.Visible = true
		canvas.Position = home + UD2(0, 0, 0, 12)
		Tween(canvas, Anim.Slow, { Position = home })
		Fader.In(canvas, Anim.Slow)
	else
		local home: UDim2 = canvas.Position
		self.HomePosition = home
		Fader.Out(canvas, Anim.Base)
		local tween = Tween(canvas, Anim.Base, { Position = home + UD2(0, 0, 0, 12) })
		tween.Completed:Once(function()
			if not self.Visible then
				self.ScreenGui.Enabled = false
				canvas.Position = home
			end
		end)
	end
end

function Window:Destroy()
	local index = TF(Callisto.Windows, self)
	if index then
		TR(Callisto.Windows, index)
	end
	Fader.Forget(self.Root)
	self.Root:Destroy()
end

--=============================================================================
-- CreateWindow - header (title) on top, vertical tab sidebar on the left,
-- footer bar (Footer / Footer 2) on the bottom
--=============================================================================

function Callisto:CreateWindow(options: { [string]: any }?)
	local opts: { [string]: any } = options or {}
	local size = opts.Size or V2(520, 520)

	local root = Add("Folder", { Parent = GetParentGui(), Name = "Callisto" })

	local screenGui = Add("ScreenGui", {
		Parent = root,
		Enabled = true,
		Name = "Window",
		ZIndexBehavior = ZIB.Sibling,
		ResetOnSpawn = false,
		IgnoreGuiInset = true,
		DisplayOrder = 999,
	})

	local canvas = Add("Frame", {
		Parent = screenGui,
		Name = "Canvas",
		AnchorPoint = V2(0.5, 0.5),
		Position = UFS(0.5, 0.5),
		Size = UFO(size.X, size.Y),
		BorderSizePixel = 0,
	})
	Bind(canvas, { BackgroundColor3 = "Background" })
	Stroke(canvas, "Border")
	Corner(canvas, 0)

	-- Subtle accent glow outline around the main window (bigger)
	local windowGlow = Add("UIStroke", {
		Parent = canvas,
		ApplyStrokeMode = ASM.Border,
		Thickness = 4,
		Transparency = 0.7,
		Color = Callisto.Theme.Accent,
		BorderStrokePosition = BSP.Outer,
	})
	Bind(windowGlow, { Color = "Accent" })

	-- ============================================================
	-- BACKGROUND IMAGE (covers entire UI)
	-- Accepts: number (asset id) or string "rbxassetid://..." / raw id
	-- Transparency: 0 = fully visible, 1 = invisible
	-- ============================================================
	local bgImage = nil
	if opts.BackgroundImage and opts.BackgroundImage ~= "" and opts.BackgroundImage ~= 0 then
		local imageStr = typeof(opts.BackgroundImage) == "number"
			and ("rbxassetid://" .. tostring(opts.BackgroundImage))
			or tostring(opts.BackgroundImage)

		if not imageStr:find("rbxassetid://") and not imageStr:find("http") then
			imageStr = "rbxassetid://" .. imageStr
		end

		bgImage = Add("ImageLabel", {
			Parent = canvas,
			Name = "BackgroundImage",
			Size = UFS(1, 1),
			Position = UFS(0, 0),
			BackgroundTransparency = 1,
			Image = imageStr,
			ImageTransparency = MC(opts.BackgroundTransparency or 0, 0, 1),
			ScaleType = SCL.Stretch, -- stretches to perfectly cover the whole UI
			ZIndex = 0,              -- always behind every other element
			BorderSizePixel = 0,
		})
		Corner(bgImage) -- matches the window's corner radius
	end

	local HEADER_HEIGHT = 35
	local FOOTER_HEIGHT = 35
	local SIDEBAR_WIDTH = opts.SidebarWidth or 130

	--- Header: just the title (tabs live in the left sidebar)
	local header = Add("Frame", {
		Parent = canvas,
		Name = "Header",
		Size = UD2(1, 0, 0, HEADER_HEIGHT),
		BorderSizePixel = 0,
		ZIndex = 1,
	})
	Bind(header, { BackgroundColor3 = "Foreground" })
	TopCorners(header)
	Stroke(header, "Border")
	List(header, {
		VerticalAlignment = VFA.Center,
		FillDirection = FD.Horizontal,
		Padding = UD(0, 12),
	})
	Padding(header, 0, 0, 10, 10)

	local textHolder = Add("Frame", {
		Parent = header,
		Name = "TextHolder",
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Size = UFS(0, 1),
		AutomaticSize = AT.X,
		BorderSizePixel = 0,
	})
	List(textHolder, { VerticalAlignment = VFA.Center, FillDirection = FD.Horizontal, Padding = UD(0, 5) })

	local title = Text(textHolder, {
		Name = "Title",
		Text = opts.Title or "Callisto",
		Size = UFS(0, 1),
		Position = UFO(10, 0),
		AutomaticSize = AT.X,
		TextSize = 17,
	})

	--- Sidebar: vertical tab list on the left, between header and footer
	local sidebar = Add("Frame", {
		Parent = canvas,
		Name = "Sidebar",
		Position = UFO(0, HEADER_HEIGHT),
		Size = UD2(0, SIDEBAR_WIDTH, 1, -(HEADER_HEIGHT + FOOTER_HEIGHT)),
		BorderSizePixel = 0,
		ZIndex = 1,
	})
	Bind(sidebar, { BackgroundColor3 = "Foreground" })

	-- thin divider on the sidebar's right edge
	local divider = Add("Frame", {
		Parent = sidebar,
		Name = "Divider",
		AnchorPoint = V2(1, 0),
		Position = UFS(1, 0),
		Size = UD2(0, 1, 1, 0),
		BorderSizePixel = 0,
		ZIndex = 2,
	})
	Bind(divider, { BackgroundColor3 = "Border" })

	local tabBar = Add("ScrollingFrame", {
		Parent = sidebar,
		Name = "Tabs",
		BackgroundTransparency = 1,
		Size = UD2(1, -1, 1, 0),
		CanvasSize = UFS(0, 0),
		AutomaticCanvasSize = AT.Y,
		ScrollingDirection = Enum.ScrollingDirection.Y,
		ScrollBarThickness = 0,
		Selectable = false,
		BorderSizePixel = 0,
	})
	Padding(tabBar, 8, 8, 8, 8)
	local tabList = List(tabBar, {
		FillDirection = FD.Vertical,
		HorizontalAlignment = HFA.Center,
		VerticalAlignment = VFA.Top,
		Padding = UD(0, 4),
	})

	local pages = Add("Frame", {
		Parent = canvas,
		Name = "Pages",
		BackgroundTransparency = 1,
		Position = UFO(SIDEBAR_WIDTH, HEADER_HEIGHT),
		Size = UD2(1, -SIDEBAR_WIDTH, 1, -(HEADER_HEIGHT + FOOTER_HEIGHT)),
		ClipsDescendants = true,
		BorderSizePixel = 0,
		ZIndex = 1,
	})
	Padding(pages, 10, 8, 12, 12)

	--- Footer bar: Footer on the bottom-left, Footer 2 on the bottom-right
	local footerBar = Add("Frame", {
		Parent = canvas,
		Name = "FooterBar",
		AnchorPoint = V2(0, 1),
		Position = UFS(0, 1),
		Size = UD2(1, 0, 0, FOOTER_HEIGHT),
		BorderSizePixel = 0,
		ZIndex = 1,
	})
	Bind(footerBar, { BackgroundColor3 = "Foreground" })
	BottomCorners(footerBar)
	Stroke(footerBar, "Border")
	List(footerBar, {
		VerticalAlignment = VFA.Center,
		HorizontalFlex = UFA.SpaceBetween,
		FillDirection = FD.Horizontal,
	})
	-- right padding leaves room for the resize handle so Footer 2 never overlaps it
	Padding(footerBar, 0, 0, 10, 28)

	local footerLabel = Text(footerBar, {
		Name = "Footer",
		LayoutOrder = 1,
		Text = opts.Footer or "https://discord.gg/robloxuis",
		TextTransparency = 0.5,
		Size = UFS(0, 1),
		RichText = true,
		AutomaticSize = AT.X,
		TextSize = opts.FooterTextSize or 13,
	})

	local footerLabel2 = Text(footerBar, {
		Name = "Footer2",
		LayoutOrder = 2,
		Text = opts.Footer2 or "Footer 2",
		TextTransparency = 0.5,
		Size = UFS(0, 1),
		RichText = true,
		AutomaticSize = AT.X,
		TextSize = opts.FooterTextSize or 13,
	})

	local resize = Add("ImageButton", {
		Parent = canvas,
		ScaleType = SCL.Fit,
		ImageTransparency = 0.5,
		Name = "Resize",
		AnchorPoint = V2(1, 1),
		Image = "rbxassetid://89501307163630",
		BackgroundTransparency = 1,
		Position = UD2(1, -6, 1, -6),
		Size = UFO(10, 10),
		ResampleMode = RSM.Pixelated,
		BorderSizePixel = 0,
		ZIndex = 5,
	})
	Hover(resize, function(hovering)
		Tween(resize, Anim.Fast, { ImageTransparency = hovering and 0 or 0.5 })
	end)

	local externals = Add("Frame", {
		Parent = screenGui,
		Name = "Externals",
		BackgroundTransparency = 1,
		Size = UFS(1, 1),
		ZIndex = 100,
		BorderSizePixel = 0,
	})

	local window: any = setmetatable({
		Root = root,
		ScreenGui = screenGui,
		Canvas = canvas,
		Header = header,
		Title = title,
		Sidebar = sidebar,
		TabBar = tabBar,
		TabList = tabList,
		Pages = pages,
		Footer = footerLabel,
		Footer2 = footerLabel2,
		FooterBar = footerBar,
		Externals = externals,
		BackgroundImage = bgImage,
		PageList = {},
		CurrentPage = nil,
		Visible = true,
		HomePosition = nil,
	}, Window)

	MakeDraggable(header, canvas)
	MakeResizable(resize, canvas, opts.MinSize or V2(400, 400))

	local toggleKey = opts.Keybind or EKC.RightShift
	Connect(UserInputService.InputBegan, function(input, processed)
		if processed then
			return
		end
		if input.UserInputType == UIT.Keyboard and input.KeyCode == toggleKey then
			window:Toggle()
		end
	end)

	local home = canvas.Position
	Fader.Out(canvas, TI(0))
	canvas.Position = home + UD2(0, 0, 0, 12)
	Tween(canvas, Anim.Slow, { Position = home })
	Fader.In(canvas, Anim.Slow)

	TIS(Callisto.Windows, window)
	return window
end

function Callisto:Unload()
	if ThemeTransition then
		ThemeTransition:Disconnect()
		ThemeTransition = nil
	end

	for _, connection in next, self.Connections do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(self.Connections)

	for index = #self.Windows, 1, -1 do
		self.Windows[index].Root:Destroy()
		self.Windows[index] = nil
	end

	table.clear(ColorRegistry)
	table.clear(GradientRegistry)
	table.clear(self.Registry)
	table.clear(FlagCounts)
	table.clear(self.Flags)
	Fader.Clear()
end

return Callisto
