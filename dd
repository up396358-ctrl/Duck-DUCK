	})
	List(row, {
		FillDirection = FD.Horizontal,
		VerticalAlignment = VFA.Center,
		HorizontalAlignment = HFA.Left,
		Padding = UD(0, 8),
	})

	-- label side: takes all remaining width, wraps instead of being cut off
	local left = Add("Frame", {
		Parent = row,
		Name = "LeftContent",
		BackgroundTransparency = 1,
		LayoutOrder = 1,
		Size = UD2(0, 0, 0, 0),
		AutomaticSize = AT.Y,
		BorderSizePixel = 0,
	})
	Add("UIFlexItem", { Parent = left, FlexMode = Enum.UIFlexMode.Fill })
	List(left, { FillDirection = FD.Horizontal, VerticalAlignment = VFA.Center })

	local label = Text(left, {
		Name = "Label",
		LayoutOrder = 1,
		Text = title,
		TextWrapped = true,
		TextXAlignment = TXA.Left,
		TextTruncate = ETT.None,
		Size = UD2(1, 0, 0, 0),
		AutomaticSize = AT.Y,
	})

	-- control side: sized to its content, always pinned to the right edge
	local right = Add("Frame", {
		Parent = row,
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Name = "RightContent",
